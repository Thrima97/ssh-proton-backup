# SSH Proton Backup configuration
# Copy to ~/.config/ssh-backup/.env and chmod 600 the copy.
# Never commit a real .env.

# Source directory to archive
SSH_DIR="${HOME}/.ssh"

# Local working directory for encrypted archives and the last fingerprint
WORK_DIR="${HOME}/.local/state/ssh-backups"

# Proton Drive destination
PROTON_PARENT="/my-files"
PROTON_FOLDER="SSH-Key-Backups"
PROTON_DIR="/my-files/SSH-Key-Backups"

# Delete local .tar.gz.gpg files older than this many days.
# Proton Drive copies are not deleted.
LOCAL_RETENTION_DAYS=7

# GPG symmetric cipher
GPG_CIPHER="AES256"

# Required. Quote the value if it contains spaces or special characters.
# Also store this password in a password manager or on paper.
# If this computer dies and you forget it, Proton copies cannot be decrypted.
GPG_PASSPHRASE=""

# Optional alternative to GPG_PASSPHRASE: path to a 600 password file
# GPG_PASSPHRASE_FILE="${HOME}/.config/ssh-backup/passphrase"

# Optional override for the last-run content hash
# FINGERPRINT_FILE="${HOME}/.local/state/ssh-backups/last-fingerprint"
